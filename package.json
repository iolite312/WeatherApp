{
  "name": "weatherapp",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "build": "pnpm --filter @weatherapp/shared build && pnpm --filter @weatherapp/api --filter @weatherapp/worker build",
